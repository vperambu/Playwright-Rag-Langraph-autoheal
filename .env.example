TEST_ENV=dev
BASE_URL=https://playwright.dev
API_BASE_URL=https://jsonplaceholder.typicode.com
API_TOKEN=
BROWSER=chromium
HEADLESS=true
PARALLEL=1
RETRY=0
STEP_TIMEOUT=60000
WEBSOCKET_URL=wss://echo.websocket.events
DEVICE=

# ─── Multi-Agent Orchestration ───────────────────────────────────────────────
# Ticket to process (override with CLI arg: node scripts/run-orchestration.js JIRA-1234)
TICKET_ID=JIRA-1234

# Execution mode: mock (no network) | live (real Jira + browser) | ci (headless artifacts)
ORCHESTRATION_MODE=mock

# Jira integration (required for live/ci mode only)
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL=user@company.com
JIRA_API_TOKEN=your_jira_api_token_here

# Set to true to post run summary as a comment back to the Jira ticket
JIRA_PUBLISH_RESULTS=false

# Test user credentials for generated specs (never hardcode in test files)
TEST_USER_EMAIL=testuser@example.com
TEST_USER_PASSWORD=

# Orchestration options
GENERATE_FEATURES=true    # Also write Gherkin .feature files alongside specs
SKIP_EXECUTION=false      # true = code generation only, skip TesterAgent
LOG_LEVEL=info            # debug | info | warn | error
LOG_PRETTY=false          # true = indented JSON (dev-friendly), false = compact (CI)
