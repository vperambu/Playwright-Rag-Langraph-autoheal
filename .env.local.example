# ─── .env.local — NEVER COMMIT THIS FILE ────────────────────────────────────
# Copy this to .env.local and fill in your real credentials.
# .env.local is listed in .gitignore and will NEVER be pushed to GitHub.
#
# How to get your Jira API token:
#   1. Go to: https://id.atlassian.com/manage-api-tokens
#   2. Click "Create API token"
#   3. Label it "playwright-orchestration"
#   4. Copy the token and paste below (it is shown only once)

# ── Jira (required for ORCHESTRATION_MODE=live or ci) ────────────────────────
JIRA_BASE_URL=https://vperambu.atlassian.net
JIRA_EMAIL=vperambup8@gmail.com
JIRA_API_TOKEN=PASTE_YOUR_TOKEN_HERE

# Set true to post the run summary as a comment back to the Jira ticket
JIRA_PUBLISH_RESULTS=false

# ── Ollama LLM (required when USE_LLM=true) ──────────────────────────────────
# Start Ollama: ollama serve   (it listens on port 11434 by default)
# Pull model:   ollama pull llama3.2
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Activate real LLM calls (set false to use deterministic rule-based generation)
USE_LLM=true

# ── Orchestration runtime ─────────────────────────────────────────────────────
ORCHESTRATION_MODE=live
TICKET_ID=SCRUM-6
GENERATE_FEATURES=true
SKIP_EXECUTION=false
LOG_LEVEL=info
LOG_PRETTY=true

# ── Framework (existing) ──────────────────────────────────────────────────────
TEST_ENV=dev
BASE_URL=https://playwright.dev
API_BASE_URL=https://jsonplaceholder.typicode.com
API_TOKEN=
BROWSER=chromium
HEADLESS=true
PARALLEL=1
RETRY=0
STEP_TIMEOUT=60000
WEBSOCKET_URL=
DEVICE=

# ── Test user credentials for generated specs ─────────────────────────────────
TEST_USER_EMAIL=testuser@example.com
TEST_USER_PASSWORD=
